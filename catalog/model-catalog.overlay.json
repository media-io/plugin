{
  "catalog_schema_version": 1,
  "_readme": [
    "人工策展层。sync 只覆盖 catalog/model-registry.snapshot.json，本文件跨同步持久，脚本只读不写。",
    "job_type 必须从快照逐字节复制：含空格与命名错位都是生产真实取值，不得规范化。",
    "stability=stable 的规则在同步时静默继承；stability=review 的会被列入待确认清单。",
    "tier 为人工标注，registry 无此字段；unknown 表示尚未与产品/服务端确认。"
  ],
  "defaults": {
    "text2image": "text2image_soul_character",
    "image2image": "image2image_media_3.0",
    "video": "image2video_tomoviee_3.0"
